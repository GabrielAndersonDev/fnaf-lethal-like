* {
	background-color: rgba(0, 0, 0, 0);
	border-color: rgba(0, 0, 0, 0);
}

#root {
	height: 100%;
	width: 100%;
	padding: 2%;
}

#player-ui-holder {
	height: 100%;
	width: 100%;
	flex-direction: column;
	align-content: center;
	justify-content: space-between;
}

#player-info-holder {
	width: 100%;
	flex-direction: row;
	justify-content: space-between;
}

#player-name {
	padding: 2% 0;
}

#player-health-stamina {
	width: 35%;
	flex-direction: column;
}

.stat-box {
	height: 40%;
	flex-direction: row;
	justify-content: flex-end;
}

.stat-box TextElement, .stat-box Label {
	-unity-text-align: middle-center;
}

#inventory-holder {
	height: 20%;
	width: 100%;
	align-items: center;
}

#inventory-title {
	-unity-text-align: middle-center;
}

#inventory-slots {
	height: 100%;
	width: 54%;
	flex-direction: row;
	justify-content: space-between;
	border-color: black;
	padding: 1%;
}

.item-slot {
	width: 24%;
	border-color: black;
	border-width: 2px;
	justify-content: flex-end;
}

.item-slot Image {
	width: 100%;
	height: 100%;
	position: absolute;
}

.item-slot Label {
	-unity-text-align: middle-center;
	align-self: center;
}