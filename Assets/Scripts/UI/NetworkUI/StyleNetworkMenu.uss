* {
	background-color: black;
	border-color: black;
	color: white;
}

#root {
	height: 100%;
	width: 100%;
	-unity-text-align: middle-center;
	align-content: center;
}

#main {
	height: 100%;
	width: 100%;
	margin: 2% 0 2% 0;
	justify-content: center;
	flex-direction: row;
}

#title {
	margin-bottom: 10px;
	font-size: 30px;
	max-height: 20%;
}

#settings, #players {
	width: 49%;
	height: 100%;
	padding: 4% 0;
	justify-content: center;
}

#start-btn-box {
	font-size: 28px;
}

#setting-elements {
	height: 100%;
	width: 100%;
	flex-direction: row;
	justify-content: center;
	align-content: flex-start;
	align-items: flex-start;
	flex-wrap: wrap;
}

#game-settings-text {
	font-size: 25px;
	margin: 5% 0 2% 0;
}

Button, IntegerField, FloatField {
	width: 75%;
	align-self: center;
}

Label {
	font-size: 15px;
}

Button, #unity-text-input {
	border-color: blue;
	height: 25px;
	padding: 0;
}

#start-btn {
	height: 35px;
	align-self: center;
}

.settings-item {
	width: 45%;
}

#use-seed-box {
	width: 100%;
	height: 30%;
	flex-direction: row;
	align-content: center;
	justify-content: center;
	align-items: flex-start;
	flex-wrap: wrap;
}

#use-seed-box Label, #use-rand-btn {
	width: 40%;
}

#player-title {
	font-size: 25px;
	margin: 5% 0 2% 0;
	-unity-text-align: middle-right;
	align-self: flex-end;
}

#players {
	align-content: flex-start;
	justify-content: flex-end;
	flex-direction: column;
	padding-right: 5%;
}

#player-container {
	width: 100%;
	height: 100%;
	padding: 10px 0;
	flex-direction: column;
	align-items: flex-end;
	justify-content: flex-start;
	flex-wrap: wrap;
}

PlayerTemplate {
	height: 80px;
	flex-direction: row;
	align-content: center;
	align-items: center;
	justify-content: flex-end;
	flex-wrap: wrap;
	margin: 2% 0;
	padding: 5px;
	border-color: blue;
	border-width: 1px;
}

PlayerTemplate #img-container {
	align-content: center;
	justify-content: flex-end;
	flex-direction: row;
	height: 100%;
	background-color: gray;
}

PlayerTemplate #img-container #player-img {
	align-content: flex-end;
	align-items: center;
	justify-content: center;
	flex-direction: row;
}

PlayerTemplate #info-container {
	height: 100%;
	flex-direction: column;
	justify-content: center;
	align-items: flex-start;
	align-content: flex-start;
}

PlayerTemplate #player-name, PlayerTemplate #player-id {
	justify-content: flex-start;
	align-items: center;
	padding: 0 5px;
	-unity-text-align: middle-left;
	font-size: 15px;
}